# ========================
# Banco de Dados (obrigatório)
# ========================
DATABASE_URL="postgresql://usuario:senha@host:5432/saas_contabil"

# ========================
# Autenticação (obrigatório)
# ========================
NEXTAUTH_URL="https://seudominio.com"
NEXTAUTH_SECRET="gere-uma-string-aleatoria-aqui-com-openssl-rand-base64-32"

# ========================
# Cron de Alertas (opcional)
# ========================
# Segredo para proteger o endpoint /api/cron/alertas
# CRON_SECRET="um-segredo-para-cron"

# ========================
# SMTP e LLM são configurados pela interface do app
# em Configurações > Email (SMTP) e Configurações > IA (LLM)
