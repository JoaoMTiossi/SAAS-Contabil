// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum StatusContrato {
  ativo
  encerrado
  renovado
  cancelado
}

enum StatusParcela {
  pendente
  pago
  cancelado
  atrasado
}

enum StatusObrigacao {
  pendente
  entregue
  cancelado
  atrasado
}

enum StatusAlerta {
  agendado
  enviado
  cancelado
}

enum PrioridadeAlerta {
  info
  atencao
  urgente
  critico
}

enum TipoAlerta {
  vencimento_geral
  parcela
  obrigacao
  renovacao
}

enum NivelConfianca {
  alta
  media
  baixa
}

// ─────────────────────────────────────────────
// Contrato
// ─────────────────────────────────────────────

model Contrato {
  id            String  @id @default(cuid())
  identificador String?
  contratante   String?
  contratado    String?

  // Vencimento geral
  dataInicio             DateTime?
  dataFim                DateTime?
  renovacaoAutomatica    Boolean?
  prazoAvisoCancelamento DateTime?

  // Status
  status StatusContrato @default(ativo)

  // Confiança da extração
  confiancaVencimento NivelConfianca @default(baixa)
  confiancaParcelas   NivelConfianca @default(baixa)
  confiancaObrigacoes NivelConfianca @default(baixa)

  // Texto original do contrato
  textoOriginal String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcelas   Parcela[]
  obrigacoes Obrigacao[]
  alertas    Alerta[]
}

// ─────────────────────────────────────────────
// Parcela
// ─────────────────────────────────────────────

model Parcela {
  id         String        @id @default(cuid())
  contratoId String
  numero     Int
  descricao  String?
  valor      Decimal?      @db.Decimal(12, 2)
  vencimento DateTime?
  status     StatusParcela @default(pendente)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  alertas  Alerta[]
}

// ─────────────────────────────────────────────
// Obrigacao
// ─────────────────────────────────────────────

model Obrigacao {
  id          String          @id @default(cuid())
  contratoId  String
  descricao   String
  responsavel String?
  prazo       DateTime?
  status      StatusObrigacao @default(pendente)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  alertas  Alerta[]
}

// ─────────────────────────────────────────────
// Alerta
// ─────────────────────────────────────────────

model Alerta {
  id          String @id @default(cuid())
  contratoId  String
  parcelaId   String?
  obrigacaoId String?

  refTipo          TipoAlerta
  refDescricao     String
  dataAlerta       DateTime
  antecedenciaDias Int
  prioridade       PrioridadeAlerta
  canais           String[]
  status           StatusAlerta @default(agendado)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contrato  Contrato   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  parcela   Parcela?   @relation(fields: [parcelaId], references: [id], onDelete: SetNull)
  obrigacao Obrigacao? @relation(fields: [obrigacaoId], references: [id], onDelete: SetNull)
}
